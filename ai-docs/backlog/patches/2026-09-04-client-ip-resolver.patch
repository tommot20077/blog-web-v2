+package dowob.xyz.blog.infrastructure.web;
+
+import jakarta.servlet.http.HttpServletRequest;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+
+/**
+ * Client IP 解析器（供 IP 層級限流等安全機制使用）
+ *
+ * <p>
+ * 採 rightmost-untrusted 演算法：將 {@code [X-Forwarded-For 各節..., remoteAddr]} 視為請求鏈，
+ * 從右往左跳過 {@code trustedProxyCount} 層受信任的反向代理後取值。
+ * X-Forwarded-For 左側節點可由 client 任意偽造，右側節點由自家 proxy 逐層附加不可偽造，
+ * 因此絕不可直接取第一節——否則攻擊者可偽造任意 IP 繞過限流。
+ * </p>
+ *
+ * <p>
+ * 信任層數由 {@code app.http.trusted-proxy-count} 配置（預設 1，對應單層 nginx 反向代理）；
+ * 設 0 表示服務直接對外，完全忽略 X-Forwarded-For。
+ * </p>
+ *
+ * @author Yuan
+ * @version 1.0
+ */
+@Component
+public class ClientIpResolver {
+
+    /** X-Forwarded-For 標頭名稱 */
+    private static final String X_FORWARDED_FOR = "X-Forwarded-For";
+
+    /** 受信任的反向代理層數 */
+    private final int trustedProxyCount;
+
+    public ClientIpResolver(@Value("${app.http.trusted-proxy-count:1}") int trustedProxyCount) {
+        this.trustedProxyCount = trustedProxyCount;
+    }
+
+    /**
+     * 解析請求的 client IP
+     *
+     * @param request HTTP 請求
+     * @return client IP 字串；無法解析時退回 {@link HttpServletRequest#getRemoteAddr()}
+     */
+    public String resolve(HttpServletRequest request) {
+        String forwardedFor = request.getHeader(X_FORWARDED_FOR);
+        if (trustedProxyCount <= 0 || forwardedFor == null || forwardedFor.isBlank()) {
+            return request.getRemoteAddr();
+        }
+
+        String[] chain = forwardedFor.split(",");
+        // 鏈尾的 remoteAddr 是第 1 層信任 proxy，故 XFF 內只需再跳過 trustedProxyCount - 1 節
+        int index = chain.length - trustedProxyCount;
+        if (index < 0) {
+            return request.getRemoteAddr();
+        }
+        return chain[index].trim();
+    }
+}
