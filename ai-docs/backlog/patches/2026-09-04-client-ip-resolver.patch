+package dowob.xyz.blog.infrastructure.web;
+
+import jakarta.servlet.http.HttpServletRequest;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.when;
+
+/**
+ * ClientIpResolver 單元測試
+ *
+ * <p>
+ * 驗證 rightmost-untrusted 演算法：以 [X-Forwarded-For 各節..., remoteAddr] 為鏈，
+ * 從右往左跳過受信任 proxy 層數後取值，使 client 端偽造的左側節點永遠不被採用。
+ * </p>
+ *
+ * @author Yuan
+ * @version 1.0
+ */
+@ExtendWith(MockitoExtension.class)
+class ClientIpResolverTest {
+
+    /** Mock：HTTP 請求 */
+    @Mock
+    private HttpServletRequest request;
+
+    /**
+     * 驗證：無 X-Forwarded-For 標頭時應回傳 remoteAddr。
+     */
+    @Test
+    @DisplayName("無 XFF 標頭 → 應回傳 remoteAddr")
+    void resolve_withoutXff_shouldReturnRemoteAddr() {
+        ClientIpResolver resolver = new ClientIpResolver(1);
+        when(request.getHeader("X-Forwarded-For")).thenReturn(null);
+        when(request.getRemoteAddr()).thenReturn("10.0.0.5");
+
+        assertThat(resolver.resolve(request)).isEqualTo("10.0.0.5");
+    }
+
+    /**
+     * 驗證：client 偽造 XFF 第一節時，1 層信任 proxy 應取 proxy 附加的最後一節（真實 IP），
+     * 而非可偽造的第一節。這是 IP 限流繞過的核心防線。
+     */
+    @Test
+    @DisplayName("偽造 XFF 第一節 + 1 層信任 proxy → 應取最後一節（真實 IP）")
+    void resolve_withForgedFirstEntry_shouldReturnRightmostUntrusted() {
+        ClientIpResolver resolver = new ClientIpResolver(1);
+        // 攻擊者送 "1.2.3.4"，反向代理附加真實 IP "203.0.113.7"
+        when(request.getHeader("X-Forwarded-For")).thenReturn("1.2.3.4, 203.0.113.7");
+
+        assertThat(resolver.resolve(request)).isEqualTo("203.0.113.7");
+    }
+
+    /**
+     * 驗證：2 層信任 proxy（如 ingress + nginx）時應取右數第二節。
+     */
+    @Test
+    @DisplayName("2 層信任 proxy → 應取右數第二節")
+    void resolve_withTwoTrustedProxies_shouldSkipInnerProxy() {
+        ClientIpResolver resolver = new ClientIpResolver(2);
+        when(request.getHeader("X-Forwarded-For")).thenReturn("1.2.3.4, 203.0.113.7, 10.42.0.1");
+
+        assertThat(resolver.resolve(request)).isEqualTo("203.0.113.7");
+    }
+
+    /**
+     * 驗證：0 層信任 proxy（直接對外）時應完全忽略 XFF，只信 remoteAddr。
+     */
+    @Test
+    @DisplayName("0 層信任 proxy → 應忽略 XFF，回傳 remoteAddr")
+    void resolve_withZeroTrustedProxies_shouldIgnoreXff() {
+        ClientIpResolver resolver = new ClientIpResolver(0);
+        when(request.getHeader("X-Forwarded-For")).thenReturn("1.2.3.4");
+        when(request.getRemoteAddr()).thenReturn("198.51.100.9");
+
+        assertThat(resolver.resolve(request)).isEqualTo("198.51.100.9");
+    }
+
+    /**
+     * 驗證：信任層數超過 XFF 鏈長度（異常配置或直連）時應退回 remoteAddr。
+     */
+    @Test
+    @DisplayName("信任層數超過鏈長 → 應退回 remoteAddr")
+    void resolve_trustedCountExceedsChain_shouldFallBackToRemoteAddr() {
+        ClientIpResolver resolver = new ClientIpResolver(3);
+        when(request.getHeader("X-Forwarded-For")).thenReturn("203.0.113.7");
+        when(request.getRemoteAddr()).thenReturn("10.0.0.5");
+
+        assertThat(resolver.resolve(request)).isEqualTo("10.0.0.5");
+    }
+
+    /**
+     * 驗證：空白 XFF 標頭應視同不存在。
+     */
+    @Test
+    @DisplayName("空白 XFF 標頭 → 應回傳 remoteAddr")
+    void resolve_blankXff_shouldReturnRemoteAddr() {
+        ClientIpResolver resolver = new ClientIpResolver(1);
+        when(request.getHeader("X-Forwarded-For")).thenReturn("   ");
+        when(request.getRemoteAddr()).thenReturn("10.0.0.5");
+
+        assertThat(resolver.resolve(request)).isEqualTo("10.0.0.5");
+    }
+}
