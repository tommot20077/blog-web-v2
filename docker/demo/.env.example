# blog-web-v2 Demo 環境變數（可選，有預設值）
#
# 所有變數都有 :-demo 預設值，不設定也能直接啟動

# PostgreSQL
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo

# Redis
REDIS_PASSWORD=demo

# Elasticsearch
ELASTIC_PASSWORD=demo

# Kibana
KIBANA_PASSWORD=demo
KIBANA_ENCRYPTION_KEY=demo_encryption_key_min_32_characters_long

# RabbitMQ
RABBITMQ_USER=demo
RABBITMQ_PASSWORD=demo

# MinIO
MINIO_ROOT_USER=demo
MINIO_ROOT_PASSWORD=demo1234
