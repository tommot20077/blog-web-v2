<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  守衛 #5 XML 掃描的反向驗證 fixture —— 故意違規，不得被當成範例。

  namespace 宣告 owner 為 article 模組，SQL 卻 JOIN user 模組的 users。
  Z2 前 users 被當作 reference data 豁免；Z2 起只有 user 模組可碰 users。
-->
<mapper namespace="dowob.xyz.blog.module.article.mapper.ViolatingUsersJoinMapper">

    <select id="findWithAuthor" resultType="map">
        SELECT a.id, u.nickname
          FROM articles a
          JOIN users u ON a.author_uuid = u.uuid
    </select>

</mapper>
