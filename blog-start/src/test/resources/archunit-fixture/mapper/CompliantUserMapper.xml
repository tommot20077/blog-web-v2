<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  守衛 #5 XML 掃描的合規對照 fixture。

  namespace 宣告 owner 為 user 模組，讀寫自己的 users 表，合規。被抓到即為假陽性。
-->
<mapper namespace="dowob.xyz.blog.module.user.mapper.CompliantUserMapper">

    <select id="findNickname" resultType="string">
        SELECT nickname FROM users WHERE uuid = #{uuid}
    </select>

    <update id="rename">
        UPDATE users SET nickname = #{nickname} WHERE uuid = #{uuid}
    </update>

</mapper>
