<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  守衛 #5 XML 掃描的合規對照 fixture。

  namespace 宣告 owner 為 article 模組，查自己的 articles 表，並唯讀 JOIN tag 參照資料
  （tags / article_tags；Yuan 2026-10-31 決定放行），皆合規。被抓到即為假陽性。
  （Z2 前此處還有 JOIN users——users 已不再是 reference data，該 JOIN 移到 ViolatingUsersJoinMapper.xml。）
-->
<mapper namespace="dowob.xyz.blog.module.article.mapper.CompliantArticleMapper">

    <select id="findWithTags" resultType="map">
        SELECT a.id, t.name
          FROM articles a
          JOIN article_tags at ON at.article_id = a.uuid
          JOIN tags t ON t.id = at.tag_id
    </select>

</mapper>
